# ============================================
# CONFIGURATION MONGODB
# ============================================

# Option 1: MongoDB Local (Recommandé pour développement)
# Utilise IPv4 (127.0.0.1) au lieu de localhost pour éviter les problèmes IPv6
MONGODB_URI=mongodb://127.0.0.1:27017/pocketguard-ai

# Option 2: MongoDB Atlas (Cloud - Gratuit)
# Décommentez la ligne ci-dessous et remplacez par votre connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pocketguard-ai?retryWrites=true&w=majority

# ============================================
# CONFIGURATION JWT (Sécurité)
# ============================================

# Générez une clé secrète aléatoire forte pour la production
# Vous pouvez générer une clé avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-random-string

# ============================================
# CONFIGURATION APPLICATION
# ============================================

# Environnement de développement
NODE_ENV=development

# Port de l'application (optionnel, Next.js utilise 3000 par défaut)
# PORT=3000

# URL de base de l'API (optionnel)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
